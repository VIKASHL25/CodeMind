# MongoDB Configuration
# Local Docker container default: mongodb://mongo:27017
# Or your MongoDB Atlas connection string: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URL=mongodb://mongo:27017
DB_NAME=codemind

# Service Secrets & API Keys
SECRET_KEY=your_jwt_secret_key_here
GROQ_API_KEY=your_groq_api_key_here
